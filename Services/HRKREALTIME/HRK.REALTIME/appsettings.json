{
  "Observability": {
    "ApiLogging": {
      "Enabled": true,
      "LogRequestBody": false,
      "LogResponseBody": false,
      "MaxBodyBytes": 4096,
      "BodyPaths": [],
      "AllowedBodyFields": []
    }
  },
  "Seq": { "ServerUrl": "" },
  "Telemetry": { "Otlp": { "Enabled": false } },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "JwtSettings": {
    "Issuer": "hrkapp",
    "Audience": "game-api"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379,abortConnect=false",
    "ChannelPrefix": "hrk:realtime"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Publishers": {
      "GameEvents": {
        "Exchange": "hrk.events",
        "ExchangeType": "topic",
        "DefaultRoutingKey": "game.default.v1",
        "Durable": true
      }
    },
    "Consumers": {
      "RealtimeProcessStatus": {
        "Exchange": "hrk.events",
        "ExchangeType": "topic",
        "Queue": "realtime.process-status.v1",
        "RoutingKeys": [ "*.process.status.updated.v1" ],
        "PrefetchCount": 20,
        "Retry": {
          "MaxRetryCount": 5,
          "DelaysMs": [ 5000, 15000, 30000, 60000, 120000 ],
          "UnknownExceptionBehavior": "Retry",
          "ErrorMaxLength": 2000
        },
        "DeadLetter": {
          "Enabled": true
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
