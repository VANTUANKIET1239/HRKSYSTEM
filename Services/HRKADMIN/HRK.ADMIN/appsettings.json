{
  "JwtSettings": {
    "Issuer": "hrkapp",
    "Audience": "game-api",
    "SecretKey": ""
  },
  "HealthMonitoring": {
    "RequestTimeoutSeconds": 10,
    "ProbeTimeoutSeconds": 4,
    "MaxConcurrency": 4,
    "Services": [
      {
        "ServiceName": "gateway",
        "ExpectedService": "ApiGateway",
        "Enabled": true
      },
      {
        "ServiceName": "auth",
        "ExpectedService": "HRK.AUTH",
        "Enabled": true
      },
      {
        "ServiceName": "game",
        "ExpectedService": "HRK.GAME",
        "Enabled": true
      },
      {
        "ServiceName": "realtime",
        "ExpectedService": "HRK.REALTIME",
        "Enabled": true
      },
      {
        "ServiceName": "activity",
        "ExpectedService": "HRK.ACTIVITY",
        "Enabled": true
      },
      {
        "ServiceName": "language",
        "ExpectedService": "HRK.LANGUAGE",
        "Enabled": true
      }
    ]
  },
  "InternalApi": {
    "Services": {
      "gateway": {
        "BaseAddress": "http://localhost:5000",
        "TimeoutSeconds": 4,
        "Retry": {
          "Enabled": false,
          "MaxRetries": 0
        },
        "CircuitBreaker": {
          "Enabled": false
        }
      },
      "auth": {
        "BaseAddress": "http://localhost:5001",
        "TimeoutSeconds": 4,
        "Retry": {
          "Enabled": false,
          "MaxRetries": 0
        },
        "CircuitBreaker": {
          "Enabled": false
        }
      },
      "game": {
        "BaseAddress": "http://localhost:5002",
        "TimeoutSeconds": 4,
        "Retry": {
          "Enabled": false,
          "MaxRetries": 0
        },
        "CircuitBreaker": {
          "Enabled": false
        }
      },
      "realtime": {
        "BaseAddress": "http://localhost:5003",
        "TimeoutSeconds": 4,
        "Retry": {
          "Enabled": false,
          "MaxRetries": 0
        },
        "CircuitBreaker": {
          "Enabled": false
        }
      },
      "activity": {
        "BaseAddress": "http://localhost:5004",
        "TimeoutSeconds": 4,
        "Retry": {
          "Enabled": false,
          "MaxRetries": 0
        },
        "CircuitBreaker": {
          "Enabled": false
        }
      },
      "language": {
        "BaseAddress": "http://localhost:5005",
        "TimeoutSeconds": 4,
        "Retry": {
          "Enabled": false,
          "MaxRetries": 0
        },
        "CircuitBreaker": {
          "Enabled": false
        }
      }
    }
  },
  "HealthChecks": {
    "DefaultTimeoutSeconds": 2
  },
  "Observability": {
    "ApiLogging": {
      "Enabled": true,
      "LogRequestBody": false,
      "LogResponseBody": false
    }
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Telemetry": {
    "Otlp": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
