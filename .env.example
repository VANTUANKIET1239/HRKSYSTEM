# Copy to .env for local Docker development. Never commit real secrets.
JWT_SECRET_KEY=replace-with-the-same-long-signing-key-used-by-auth-and-game
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Local observability. Generate the hash with: docker run --rm -it datalust/seq:2025.2 config hash
SEQ_ADMIN_PASSWORD_HASH=replace-with-generated-seq-password-hash
# Convenience value for local login; Compose uses the hash above.
SEQ_ADMIN_PASSWORD=replace-with-your-local-seq-admin-password
ACTIVITY_DB_CONNECTION_STRING='Server=host.docker.internal,1433;Database=HRK_Activity;User Id=replace-with-game-sql-login;Password=replace-with-game-sql-password;Encrypt=True;TrustServerCertificate=True;'
# Local ingestion does not require an API key. Create keys in Seq before enabling authentication.
SEQ_REQUIRE_INGESTION_AUTH=false
SEQ_INGESTION_API_KEY=
