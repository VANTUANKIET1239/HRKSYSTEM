<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Database-managed Quartz scheduling, execution history and scoped job handlers.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.1" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.15.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.6" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core.Persistence.Abstractions/Core.Persistence.Abstractions.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Update="Scripts/**/*.sql" Pack="true" PackagePath="contentFiles/any/any/Scripts" />
  </ItemGroup>
</Project>
